{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(ruff:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(mypy:*)",
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make type-check)",
      "Bash(make test)",
      "Bash(make coverage)",
      "Bash(make schema)",
      "Bash(make schema-check)",
      "Bash(make eval)",
      "Bash(make validate-compliance)",
      "Bash(make helm-test)",
      "Bash(make ci-success)",
      "Bash(make docs)",
      "Bash(pre-commit run:*)",
      "Bash(pip list)",
      "Bash(pip list:*)",
      "Bash(pip show:*)",
      "Bash(pip freeze)",
      "Bash(pipx list)",
      "Bash(pipx run:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(helm unittest:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force)",
      "Bash(git push --force:*)",
      "Bash(git push -f)",
      "Bash(git push -f:*)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)"
    ]
  }
}
